# Non-secret Agent Visor release coordinates.
#
# The semantic product version is read from the root package.json. Keep the
# bundle build number here so every release artifact has one tracked source.
AGENT_VISOR_BUILD="54"
AGENT_VISOR_MIN_MACOS="14.0"
AGENT_VISOR_BUNDLE_IDENTIFIER="com.824zzy.AgentVisor"
AGENT_VISOR_EXECUTABLE="Agent Visor"
AGENT_VISOR_PRODUCT_NAME="Agent Visor"
# Used by the Electron app and native helper when owner navigation sends
# Apple Events to the selected terminal session.
AGENT_VISOR_APPLE_EVENTS_USAGE_DESCRIPTION="Agent Visor uses automation to focus and control the terminal session you choose."
AGENT_VISOR_THIRD_PARTY_LICENSES_DIR="ThirdPartyLicenses"
